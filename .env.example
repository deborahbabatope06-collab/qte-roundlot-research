# Copy this file to .env (same folder) and paste your team token. .env is git-ignored.
QTE_TOKEN=paste-your-team-token-here
# Optional: your team name exactly as the exchange states it (desk.log: "connected as team ...")
QTE_TEAM=
# Optional: the history service (this is the default)
QTE_HISTORY_URL=https://history.trading.queenstowerexchange.com
